{
  "version": 2,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "env": {
    "DATABASE_URL": {
      "description": "MySQL/TiDB connection string"
    },
    "JWT_SECRET": {
      "description": "Session cookie signing secret"
    },
    "VITE_APP_ID": {
      "description": "OAuth application ID"
    },
    "OAUTH_SERVER_URL": {
      "description": "OAuth server URL"
    },
    "VITE_OAUTH_PORTAL_URL": {
      "description": "OAuth portal URL"
    },
    "OWNER_OPEN_ID": {
      "description": "Owner's OpenID"
    },
    "OWNER_NAME": {
      "description": "Owner's name"
    },
    "BUILT_IN_FORGE_API_URL": {
      "description": "Manus API URL"
    },
    "BUILT_IN_FORGE_API_KEY": {
      "description": "Manus API key"
    },
    "VITE_FRONTEND_FORGE_API_KEY": {
      "description": "Frontend Manus API key"
    },
    "VITE_FRONTEND_FORGE_API_URL": {
      "description": "Frontend Manus API URL"
    }
  },
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
